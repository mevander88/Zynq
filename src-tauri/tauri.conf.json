{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zynq",
  "version": "0.1.0",
  "identifier": "app.zynq.live",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:sidecar && npm run connector:install && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zynq — LIVE Control Desk",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/node"],
    "resources": ["../connector/index.cjs", "../connector/protocol.cjs", "../connector/package.json", "../connector/node_modules/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
